# Derived from stock X663 firmware and the working X663 TWRP port; see NOTICE.
#
# ueventd loads this as /ueventd.${ro.hardware}.rc when ro.hardware is mt6768.
# It gives the MTK block devices the ownership the stock build used; recovery
# runs as root, but adbd, minadbd and the update engine do not.

/dev/block/mmcblk0                                         0660   root   system
/dev/block/mmcblk0boot0                                    0660   root   system
/dev/block/mmcblk0boot1                                    0660   root   system
/dev/block/mmcblk0rpmb                                     0660   root   system
/dev/block/by-name/expdb                                   0640   root   system
/dev/block/by-name/boot                                    0640   root   system
/dev/block/by-name/boot_a                                  0640   root   system
/dev/block/by-name/boot_b                                  0640   root   system
/dev/block/by-name/vendor_boot                             0640   root   system
/dev/block/by-name/vendor_boot_a                           0640   root   system
/dev/block/by-name/vendor_boot_b                           0640   root   system
/dev/block/by-name/dtbo                                    0640   root   system
/dev/block/by-name/dtbo_a                                  0640   root   system
/dev/block/by-name/dtbo_b                                  0640   root   system
/dev/block/by-name/md1img                                  0640   root   system
/dev/block/by-name/md1img_a                                0640   root   system
/dev/block/by-name/md1img_b                                0640   root   system
/dev/block/by-name/boot_para                               0640   root   system
/dev/block/by-name/seccfg                                  0660   root   system
/dev/block/by-name/proinfo                                 0660   root   system
/dev/block/by-name/nvram                                   0660   root   system
/dev/block/by-name/para                                    0660   root   system
/dev/block/by-name/logo                                    0660   root   system
/dev/block/by-name/frp                                    0660   root   system
/dev/block/by-name/misc                                    0660   root   system
/dev/block/by-name/otp                                     0660   root   system
/dev/block/by-name/md1dsp                                  0660   root   system
/dev/block/by-name/tee1                                    0660   root   system
/dev/block/by-name/tee2                                    0660   root   system

# MTK UFS boot LUNs (kept for parity with the working port; emmc device)
/dev/block/sda                                             0660   root   system
/dev/block/sdb                                             0660   root   system
