# Derived from stock X663 firmware and AOSP's own recovery init; see NOTICE.
#
# UDC binding.  /system/etc/init/hw/init.rc writes ${sys.usb.controller} into
# /config/usb_gadget/g1/UDC and nothing in the ramdisk sets that property, so
# the gadget is created and never bound: adb and fastbootd stay dark.
#
# musb-hdrc is this part's controller, from the firmware itself: the stock
# recovery script writes /sys/class/udc/musb-hdrc/device/cmode, and the stock
# vendor script sets vendor.usb.controller "musb-hdrc".
#
# kernel_init_done is the parameter the stock vendor script raises at
# early-init before any gadget work; the kernel carries it as
# musb_hdrc.kernel_init_done.

on early-init
    write /sys/module/musb_hdrc/parameters/kernel_init_done 1

on init
    setprop sys.usb.controller "musb-hdrc"

on fs
    # AOSP recovery raises sys.usb.config only when the panel offers
    # "Apply update from ADB"; raise it here so a dead panel can still be
    # diagnosed.  Stock recovery does the same with a bare `start adbd`.
    setprop sys.usb.config adb
