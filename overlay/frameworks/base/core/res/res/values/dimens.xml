<?xml version="1.0" encoding="utf-8"?>
<!-- Framework dimens overlay for the Infinix Note 11 (X663). -->
<resources>

    <!-- Status bar: 36dp portrait, 28dp landscape. -->
    <dimen name="status_bar_height_portrait">36dp</dimen>
    <dimen name="status_bar_height_landscape">28dp</dimen>

    <!-- Display corners and the Quick Settings top padding follow the notch
         height so the shade clears the rounded corners. -->
    <dimen name="rounded_corner_radius">36dp</dimen>
    <dimen name="quick_qs_offset_height">36dp</dimen>

    <!-- Resolver (share sheet) maximum heights. -->
    <dimen name="resolver_max_collapsed_height">342dp</dimen>
    <dimen name="resolver_max_collapsed_height_with_tabs">390dp</dimen>

    <!-- Toast offset from the bottom of the screen. -->
    <dimen name="toast_y_offset">72dp</dimen>

</resources>
