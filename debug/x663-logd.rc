# SPDX-License-Identifier: Apache-2.0
# First-boot debug logging

service x663-logd /system/bin/sh /system/bin/x663-logd.sh
    class core
    user root
    group root system log
    seclabel u:r:su:s0
    priority -10
    oom_score_adjust -1000
    disabled

service x663-logreport /system/bin/sh /system/bin/x663-logreport.sh
    class core
    user root
    group root system log
    seclabel u:r:su:s0
    oneshot
    disabled

service x663-logmirror /system/bin/sh /system/bin/x663-logmirror.sh
    class core
    user root
    group root system log sdcard_rw media_rw
    seclabel u:r:su:s0
    priority 10
    oom_score_adjust -1000
    disabled

on early-init
    write /sys/module/musb_hdrc/parameters/kernel_init_done 1

on init
    setprop sys.usb.controller "musb-hdrc"
    setprop vendor.usb.controller "musb-hdrc"

on fs
    start x663-logd

on post-fs
    setprop vendor.usb.vid "0x0E8D"
    setprop sys.usb.controller "musb-hdrc"
    setprop vendor.usb.controller "musb-hdrc"
    setprop sys.usb.configfs 1
    setprop vendor.usb.acm_cnt 0
    setprop vendor.usb.acm_port0 ""
    setprop vendor.usb.acm_port1 ""
    setprop vendor.usb.acm_enable 0
    setprop vendor.usb.clear_port 1

on post-fs-data
    start x663-logmirror

on property:apexd.status=activated && property:ro.debuggable=1
    setprop sys.usb.config adb

on property:sys.boot_completed=1
    start x663-logreport

on property:ro.persistent_properties.ready=true
    setprop persist.sys.usb.config adb

on boot
    start x663-logmirror
    setprop persist.sys.usb.config adb
