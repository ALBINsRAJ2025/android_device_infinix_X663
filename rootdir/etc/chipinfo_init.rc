on early-init
    setprop ro.soc.model MT6768
    setprop ro.soc.manufacturer Mediatek

on post-fs-data
    setprop ro.soc.model MT6768
    setprop ro.soc.manufacturer Mediatek
    setprop ro.vendor.soc.model MT6768
    setprop ro.vendor.soc.manufacturer Mediatek
    setprop ro.vendor.soc.model_ready 1
